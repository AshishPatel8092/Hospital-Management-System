# Copy this file to .env and fill in your real values. Never commit .env itself.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hms_db
# Set to true if your MySQL host requires/offers TLS (e.g. some managed
# hosts like Railway's MySQL plugin). Leave unset or false for local MySQL.
DB_SSL=false

# Any long random string - used to sign the login session cookie
SESSION_SECRET=change_this_to_a_long_random_string

PORT=3000
